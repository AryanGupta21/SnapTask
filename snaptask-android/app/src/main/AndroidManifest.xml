<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.SnapTask"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            ShareReceiverActivity is a transparent bottom-sheet activity.
            It appears on top of the caller (Samsung Camera, Gallery, etc.)
            and dismisses itself after Execute or Cancel.
        -->
        <activity
            android:name=".ShareReceiverActivity"
            android:theme="@style/Theme.SnapTask.BottomSheet"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

    </application>

</manifest>
